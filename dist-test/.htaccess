Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ---- Legacy WordPress and alias URLs (generated from LEGACY_RULES) ----
  RewriteRule ^(?:shipping-containers-for-sale|shipping-containers|(?:new|used|buy)-shipping-containers|shipping-container-hire|container-hire)-(brisbane|ipswich|gold-coast|sunshine-coast|logan|jimboomba|beaudesert|redlands|toowoomba|gatton|laidley|esk|fernvale|warwick|dalby|chinchilla|rockhampton|gladstone|mackay|townsville|cairns|bundaberg|hervey-bay|maryborough|gympie|kingaroy|tweed-heads|ballina|lismore|mullumbimby|grafton|sydney|melbourne|bendigo|perth|mandurah|rockingham|joondalup|bunbury|busselton|albany|geraldton|kalgoorlie|darwin|palmerston|humpty-doo)/?$ /$1/ [R=301,L,NC]
  RewriteRule ^(?:contact-us|contact-fair-dinkum-containers|get-a-quote|request-a-quote|quote)/?$ /contact/ [R=301,L,NC]
  RewriteRule ^(?:about-us|our-story|about-fair-dinkum-containers|who-we-are)/?$ /about/ [R=301,L,NC]
  RewriteRule ^(?:faq|frequently-asked-questions|faqs-2)/?$ /faqs/ [R=301,L,NC]
  RewriteRule ^(?:hire|container-hire|containers-for-hire|shipping-containers-for-hire|shipping-container-rental|container-rental)/?$ /shipping-container-hire/ [R=301,L,NC]
  RewriteRule ^(?:sales|buy|containers-for-sale|shipping-containers-for-sale)/?$ /container-sales/ [R=301,L,NC]
  RewriteRule ^(?:containers|products?|our-containers|our-range|range|shop|store)/?$ /shipping-containers/ [R=301,L,NC]
  RewriteRule ^product-category/[a-z0-9-]+(?:/page/\d+)?/?$ /shipping-containers/ [R=301,L,NC]
  RewriteRule ^(?:cart|checkout|my-account)(?:/[a-z0-9-]+)*/?$ /shipping-containers/ [R=301,L,NC]
  RewriteRule ^(10|20|40)-(?:foot|ft)-shipping-containers?/?$ /$1ft-shipping-containers/ [R=301,L,NC]
  RewriteRule ^product/[a-z0-9-]*(?:10ft|10-foot|10-ft)[a-z0-9-]*/?$ /10ft-shipping-containers/ [R=301,L,NC]
  RewriteRule ^product/[a-z0-9-]*(?:20ft|20-foot|20-ft)[a-z0-9-]*/?$ /20ft-shipping-containers/ [R=301,L,NC]
  RewriteRule ^product/[a-z0-9-]*(?:40ft|40-foot|40-ft)[a-z0-9-]*/?$ /40ft-shipping-containers/ [R=301,L,NC]
  RewriteRule ^product/[a-z0-9-]+/?$ /shipping-containers/ [R=301,L,NC]
  RewriteRule ^(?:delivery-area|areas-we-service|service-areas?|locations?|where-we-deliver)/?$ /delivery-areas/ [R=301,L,NC]
  RewriteRule ^(?:shipping-container-delivery|container-delivery)/?$ /delivery/ [R=301,L,NC]
  RewriteRule ^(?:privacy-policy|privacy-statement)/?$ /privacy/ [R=301,L,NC]
  RewriteRule ^(?:storage|storage-containers|container-storage-solutions|self-storage)/?$ /container-storage/ [R=301,L,NC]
  RewriteRule ^(?:modifications|container-modifications?|custom-containers)/?$ /blog/shipping-container-modifications/ [R=301,L,NC]
  RewriteRule ^(?:container-dimensions|shipping-container-dimensions|sizes)/?$ /dimensions/ [R=301,L,NC]
  RewriteRule ^(?:news|articles|guides|shipping-container-guides)/?$ /blog/ [R=301,L,NC]
  RewriteRule ^blog/page/\d+/?$ /blog/ [R=301,L,NC]
  RewriteRule ^\d{4}/\d{2}(?:/\d{2})?(?:/[a-z0-9-]+)?/?$ /blog/ [R=301,L,NC]
  RewriteRule ^(?:category|tag|author)/[a-z0-9-]+(?:/page/\d+)?/?$ /blog/ [R=301,L,NC]
  RewriteRule ^(?:feed|comments/feed)/?$ /blog/ [R=301,L,NC]
  RewriteRule ^(?:sitemap_index|page-sitemap|post-sitemap|product-sitemap|product_cat-sitemap|category-sitemap|wp-sitemap)\.xml$ /sitemap.xml [R=301,L,NC]

  # ---- Canonical case and trailing slash, one rule per built page ----
  RewriteCond %{REQUEST_URI} !^/shipping-containers/$
  RewriteRule ^shipping-containers/?$ /shipping-containers/ [R=301,L,NC]
